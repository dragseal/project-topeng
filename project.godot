;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Topeng"
run/main_scene="uid://dtcivooc63khh"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DialogueManager="*uid://c3rodes2l3gxb"
Simpleton="*uid://bl8w22kf3j50s"

[dialogue_manager]

runtime/advanced/uses_dotnet=true
runtime/balloon_path="res://Dialogue/Balloon/Balloon.tscn"

[display]

window/size/viewport_width=320
window/size/viewport_height=240
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="Project Topeng"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[global_group]

